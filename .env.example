# Copy to .env.local and fill in. Never commit .env.local.
#
# Values are left empty rather than filled with realistic-looking placeholders:
# a dummy that matches a real key's shape trips GitHub's secret scanning and
# blocks the push.

# Supabase ---------------------------------------------------------------
# The URL and publishable key are safe to expose in the browser.
# Dashboard -> Project Settings -> API keys.

NEXT_PUBLIC_SUPABASE_URL=https://fzgtqrtawefobosqgjzn.supabase.co

# starts sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# starts sb_secret_ . Server only: full access, bypasses Row Level Security.
# Never expose this to the browser and never commit it.
SUPABASE_SECRET_KEY=

# Stripe -----------------------------------------------------------------
# Quote-first: invoices are raised server-side and paid on Stripe's own hosted
# pages, so nothing Stripe-related runs in the browser and no publishable key
# is needed.

# starts sk_ , or rk_ for a restricted key. Needs write on customers,
# invoices, invoice items and billing portal sessions.
STRIPE_SECRET_KEY=

# starts whsec_ . Shown once, when the webhook endpoint is created.
STRIPE_WEBHOOK_SECRET=

# PayPal (existing live plan - left untouched, runs alongside Stripe) -----
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_PLAN_ID=P-9LC13734BP044845DNGTVBQA
